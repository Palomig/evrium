# Корневой сайт эвриум.рф — статический сайт репетитора.
# /crm/, /zarplata/, /oge-zadachi/ и прочие подпапки обслуживаются как раньше.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Trailing slash для ЧПУ /matematika/ → matematika/index.html
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_URI} !^/(crm|zarplata|oge-zadachi)(/|$)
    RewriteRule ^(.+)$ /$1/ [R=301,L]

    # Если файл существует — отдать как есть
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    ErrorDocument 404 /404.html
</IfModule>

DirectoryIndex index.html index.php

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes

<FilesMatch "^(config\.php|config\.example\.php|\.env)$">
    Require all denied
</FilesMatch>
