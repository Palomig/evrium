# Корневой сайт эвриум.рф — статический сайт репетитора.
# /crm/, /zarplata/, /oge-zadachi/ и прочие подпапки обслуживаются как раньше.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Канонический адрес: https:// без www ---------------------------------
    # Иначе одна страница доступна по четырём адресам (http/https × www/без www)
    # и поисковики считают их дублями.
    #
    # SSL терминируется на прокси хостинга, поэтому проверяем оба признака:
    # по https приходят и HTTPS=On, и X-Forwarded-Proto (проверено на проде),
    # по http — ни одного. Два условия разом исключают петлю редиректов.
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
    RewriteCond %{HTTPS} !=on [NC]
    RewriteRule ^ https://xn--b1ammoq0d.xn--p1ai%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://xn--b1ammoq0d.xn--p1ai%{REQUEST_URI} [R=301,L]

    # Привычный /sitemap.xml — на реальный индекс карты сайта
    RewriteRule ^sitemap\.xml$ https://xn--b1ammoq0d.xn--p1ai/sitemap-index.xml [R=301,L]

    # Trailing slash для ЧПУ /matematika/ → matematika/index.html
    # Адрес обязательно абсолютный: SSL терминируется на прокси, и с
    # относительным путём Apache подставлял бы http:// — лишний хоп и
    # выброс посетителя на незащищённый протокол.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_URI} !^/(crm|zarplata|oge-zadachi)(/|$)
    RewriteRule ^(.+)$ https://xn--b1ammoq0d.xn--p1ai/$1/ [R=301,L]

    # Если файл существует — отдать как есть
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    ErrorDocument 404 /404.html
</IfModule>

DirectoryIndex index.html index.php

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes

<FilesMatch "^(config\.php|config\.example\.php|\.env)$">
    Require all denied
</FilesMatch>
