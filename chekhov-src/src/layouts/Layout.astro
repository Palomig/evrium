---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** JSON-LD schema, добавляется к стандартному LocalBusiness */
  extraSchema?: object | object[];
}

const { title, description, ogImage, noindex, extraSchema } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const ogImageUrl = ogImage
  ? new URL(ogImage, site.domain).href
  : `${site.domain}${site.basePath}/og-default.jpg`;

// Хлебные крошки (Schema.org BreadcrumbList) — генерируются из пути.
const crumbLabels: Record<string, string> = {
  matematika: 'Математика', informatika: 'Информатика', fizika: 'Физика',
  oge: 'Подготовка к ОГЭ', ege: 'Подготовка к ЕГЭ', ceny: 'Цены',
  kabinet: 'Кабинет', otzyvy: 'Отзывы', kontakty: 'Контакты', blog: 'Блог',
  'politika-konfidencialnosti': 'Политика конфиденциальности',
};
const segments = Astro.url.pathname.split('/').filter(Boolean);
let breadcrumb: object | null = null;
if (segments.length > 0) {
  const crumbs = [{ name: 'Главная', url: `${site.domain}/` }];
  let acc = '';
  segments.forEach((seg, i) => {
    acc += `/${seg}`;
    const last = i === segments.length - 1;
    crumbs.push({
      name: crumbLabels[seg] || (last ? title.split(' — ')[0].split(' | ')[0] : seg),
      url: `${site.domain}${acc}/`,
    });
  });
  breadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, idx) => ({
      '@type': 'ListItem', position: idx + 1, name: c.name, item: c.url,
    })),
  };
}

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${site.domain}/#org`,
  name: `${site.centerName} — ${site.centerTagline}`,
  description: site.centerBio,
  url: `${site.domain}${site.basePath}/`,
  logo: `${site.domain}${site.basePath}/favicon.svg`,
  image: `${site.domain}${site.basePath}/og-default.jpg`,
  priceRange: '₽₽',
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: 'Чехов',
    addressRegion: 'Московская область',
    addressCountry: 'RU',
    ...(site.postalCode ? { postalCode: site.postalCode } : {}),
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  areaServed: site.studentAreas.map((name) => ({ '@type': 'Place', name })),
  sameAs: [site.whatsapp, site.telegram, site.mapUrl].filter(Boolean),
};

const schemas = [
  localBusiness,
  ...(breadcrumb ? [breadcrumb] : []),
  ...(extraSchema ? (Array.isArray(extraSchema) ? extraSchema : [extraSchema]) : []),
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#1C1813" />

  {/* Фирменные кириллические шрифты */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Golos+Text:wght@400;500;600;700&display=swap" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonical} />

  {/* Open Graph */}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={site.centerName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  {!ogImage && <meta property="og:image:width" content="1200" />}
  {!ogImage && <meta property="og:image:height" content="630" />}
  {!ogImage && <meta property="og:image:type" content="image/jpeg" />}
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href={`${site.basePath}/favicon.svg`} />

  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  {/*
    Яндекс Метрика — загружается ТОЛЬКО после согласия в cookie-плашке.
    Без согласия скрипт mc.yandex.ru вообще не запрашивается, куки не ставятся.
    noscript-пиксель убран сознательно: при выключенном JS мы не можем проверить
    согласие, поэтому корректнее не трекать вовсе.
  */}
  <script type="text/javascript" is:inline define:vars={{ ymId: site.yandexMetrikaId }}>
    (function () {
      let loaded = false;
      function loadMetrika() {
        if (loaded) return;
        loaded = true;
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
        ym(ymId, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
        window.__ymId = ymId;
      }

      let consent = null;
      try { consent = JSON.parse(localStorage.getItem('cookie-consent-v1') || 'null'); } catch (e) {}
      if (consent && consent.analytics) {
        loadMetrika();
      } else {
        // Если согласие появится в ходе сессии — подхватим без перезагрузки страницы
        document.addEventListener('cookie-consent-change', function (e) {
          if (e && e.detail && e.detail.analytics) loadMetrika();
        });
      }
    })();

    // Глобальный трекинг кликов по CTA (WhatsApp/Telegram/телефон) — на всех страницах
    document.addEventListener('click', function (e) {
      var el = e.target.closest && e.target.closest('[data-cta]');
      if (!el || !window.ym) return;
      var n = el.getAttribute('data-cta') || '';
      var g = n.indexOf('whatsapp') === 0 ? 'click_whatsapp'
            : n.indexOf('telegram') === 0 ? 'click_telegram'
            : n.indexOf('phone') === 0 ? 'click_phone' : null;
      if (g) window.ym(window.__ymId || 0, 'reachGoal', g);
    });
  </script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <FloatingCTA />
  <CookieBanner />
</body>
</html>
