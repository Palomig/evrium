---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** JSON-LD schema, добавляется к стандартному LocalBusiness */
  extraSchema?: object | object[];
}

const { title, description, ogImage, noindex, extraSchema } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;
// TODO: подготовить og-default.jpg (1200x630) и заменить .svg на .jpg —
// большинство соцсетей надёжнее показывают превью с растровыми картинками.
const ogImageUrl = ogImage
  ? new URL(ogImage, site.domain).href
  : `${site.domain}${site.basePath}/og-default.svg`;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: `${site.centerName} — ${site.centerTagline}`,
  description: site.centerBio,
  url: `${site.domain}${site.basePath}/`,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: 'Чехов',
    addressRegion: 'Московская область',
    addressCountry: 'RU',
    ...(site.postalCode ? { postalCode: site.postalCode } : {}),
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  areaServed: site.studentAreas.map((name) => ({ '@type': 'Place', name })),
  sameAs: [site.whatsapp, site.telegram].filter(Boolean),
};

const schemas = extraSchema
  ? [localBusiness, ...(Array.isArray(extraSchema) ? extraSchema : [extraSchema])]
  : [localBusiness];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#15324d" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonical} />

  {/* Open Graph */}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={site.centerName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href={`${site.basePath}/favicon.svg`} />

  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  {/*
    Яндекс Метрика — загружается ТОЛЬКО после согласия в cookie-плашке.
    Без согласия скрипт mc.yandex.ru вообще не запрашивается, куки не ставятся.
    noscript-пиксель убран сознательно: при выключенном JS мы не можем проверить
    согласие, поэтому корректнее не трекать вовсе.
  */}
  <script type="text/javascript" is:inline define:vars={{ ymId: site.yandexMetrikaId }}>
    (function () {
      let loaded = false;
      function loadMetrika() {
        if (loaded) return;
        loaded = true;
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
        ym(ymId, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true });
      }

      let consent = null;
      try { consent = JSON.parse(localStorage.getItem('cookie-consent-v1') || 'null'); } catch (e) {}
      if (consent && consent.analytics) {
        loadMetrika();
      } else {
        // Если согласие появится в ходе сессии — подхватим без перезагрузки страницы
        document.addEventListener('cookie-consent-change', function (e) {
          if (e && e.detail && e.detail.analytics) loadMetrika();
        });
      }
    })();
  </script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <FloatingCTA />
  <CookieBanner />
</body>
</html>
