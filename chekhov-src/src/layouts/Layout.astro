---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** JSON-LD schema, добавляется к стандартному LocalBusiness */
  extraSchema?: object | object[];
}

const { title, description, ogImage, noindex, extraSchema } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const ogImageUrl = ogImage
  ? new URL(ogImage, site.domain).href
  : `${site.domain}${site.basePath}/og-default.jpg`;

// Хлебные крошки (Schema.org BreadcrumbList) — генерируются из пути.
const crumbLabels: Record<string, string> = {
  matematika: 'Математика', informatika: 'Информатика', fizika: 'Физика',
  oge: 'Подготовка к ОГЭ', ege: 'Подготовка к ЕГЭ', ceny: 'Цены',
  kabinet: 'Кабинет', otzyvy: 'Отзывы', kontakty: 'Контакты', blog: 'Блог',
  'politika-konfidencialnosti': 'Политика конфиденциальности',
  'soglasie-na-obrabotku-personalnyh-dannyh': 'Согласие на обработку персональных данных',
};
const segments = Astro.url.pathname.split('/').filter(Boolean);
let breadcrumb: object | null = null;
if (segments.length > 0) {
  const crumbs = [{ name: 'Главная', url: `${site.domain}/` }];
  let acc = '';
  segments.forEach((seg, i) => {
    acc += `/${seg}`;
    const last = i === segments.length - 1;
    crumbs.push({
      name: crumbLabels[seg] || (last ? title.split(' — ')[0].split(' | ')[0] : seg),
      url: `${site.domain}${acc}/`,
    });
  });
  breadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, idx) => ({
      '@type': 'ListItem', position: idx + 1, name: c.name, item: c.url,
    })),
  };
}

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${site.domain}/#org`,
  name: `${site.centerName} — ${site.centerTagline}`,
  description: site.centerBio,
  url: `${site.domain}${site.basePath}/`,
  logo: `${site.domain}${site.basePath}/favicon.svg`,
  image: `${site.domain}${site.basePath}/og-default.jpg`,
  priceRange: '₽₽',
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: 'Чехов',
    addressRegion: 'Московская область',
    addressCountry: 'RU',
    ...(site.postalCode ? { postalCode: site.postalCode } : {}),
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.openingHours.days,
    opens: site.openingHours.opens,
    closes: site.openingHours.closes,
  }],
  areaServed: site.studentAreas.map((name) => ({ '@type': 'Place', name })),
  sameAs: [site.whatsapp, site.telegram, site.mapUrl].filter(Boolean),
};

const schemas = [
  localBusiness,
  ...(breadcrumb ? [breadcrumb] : []),
  ...(extraSchema ? (Array.isArray(extraSchema) ? extraSchema : [extraSchema]) : []),
];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#1C1813" />

  {/* Фирменные кириллические шрифты */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Golos+Text:wght@400;500;600;700&display=swap" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonical} />

  {/* Open Graph */}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={site.centerName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  {!ogImage && <meta property="og:image:width" content="1200" />}
  {!ogImage && <meta property="og:image:height" content="630" />}
  {!ogImage && <meta property="og:image:type" content="image/jpeg" />}
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href={`${site.basePath}/favicon.svg`} />

  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  {/*
    Яндекс Метрика — базовый счётчик (визиты, источники, карты кликов) загружается
    всегда, иначе большинство посетителей (кто игнорирует cookie-плашку) невидимы.
    Вебвизор (запись сессий) включается только после согласия в плашке; если
    согласие дано в ходе сессии — запись начнётся со следующей страницы.
  */}
  <script type="text/javascript" is:inline define:vars={{ ymId: site.yandexMetrikaId }}>
    (function () {
      let consent = null;
      try { consent = JSON.parse(localStorage.getItem('cookie-consent-v1') || 'null'); } catch (e) {}
      var withWebvisor = !!(consent && consent.analytics);

      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();
      for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
      ym(ymId, "init", { clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor: withWebvisor });
      window.__ymId = ymId;
    })();

    // Глобальный трекинг кликов по CTA (WhatsApp/Telegram/телефон) — на всех страницах
    document.addEventListener('click', function (e) {
      var el = e.target.closest && e.target.closest('[data-cta]');
      if (!el || !window.ym) return;
      var n = el.getAttribute('data-cta') || '';
      var g = n.indexOf('whatsapp') === 0 ? 'click_whatsapp'
            : n.indexOf('telegram') === 0 ? 'click_telegram'
            : n.indexOf('phone') === 0 ? 'click_phone' : null;
      if (g) window.ym(window.__ymId || 0, 'reachGoal', g);
    });
  </script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <FloatingCTA />
  <CookieBanner />

  <!-- Сквозная аналитика: захват источника (utm/yclid/clientID) и проброс в форму заявки -->
  <script is:inline>
    (function () {
      var KEY = 'attr_v1';
      function load() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
      function save(o) { try { localStorage.setItem(KEY, JSON.stringify(o)); } catch (e) {} }
      var p = new URLSearchParams(location.search);
      var cur = {};
      ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'].forEach(function (k) { if (p.get(k)) cur[k] = p.get(k); });
      var y = p.get('yclid'); if (y) cur.yclid = y;
      var data = load() || { landing: location.pathname, referrer: document.referrer || '' };
      if (Object.keys(cur).length) { for (var k in cur) data[k] = cur[k]; data.ts = new Date().toISOString(); }
      save(data);

      function inject() {
        document.querySelectorAll('form[data-lead-form]').forEach(function (f) {
          for (var k in data) {
            if (!data[k] || f.querySelector('[name="' + k + '"]')) continue;
            var i = document.createElement('input'); i.type = 'hidden'; i.name = k; i.value = data[k]; f.appendChild(i);
          }
        });
      }
      inject();

      function addClientId() {
        if (!window.ym) return;
        try { window.ym(window.__ymId || 0, 'getClientID', function (id) {
          document.querySelectorAll('form[data-lead-form]').forEach(function (f) {
            if (f.querySelector('[name="ym_client_id"]')) return;
            var i = document.createElement('input'); i.type = 'hidden'; i.name = 'ym_client_id'; i.value = id; f.appendChild(i);
          });
        }); } catch (e) {}
      }
      if (window.ym) addClientId();
      else document.addEventListener('cookie-consent-change', function () { setTimeout(addClientId, 1500); });
    })();
  </script>
</body>
</html>
