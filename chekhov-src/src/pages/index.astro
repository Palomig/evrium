<script>
  // Маска телефона +7 (999) 555 22 11
  function fmtPhone(raw) {
    let d = String(raw).replace(/\D/g, '');
    if (d.startsWith('8')) d = '7' + d.slice(1);
    if (!d.startsWith('7')) d = '7' + d;
    d = d.slice(0, 11);
    let out = '+7';
    if (d.length > 1) out += ' (' + d.slice(1, 4);
    if (d.length >= 4) out += ')';
    if (d.length >= 5) out += ' ' + d.slice(4, 7);
    if (d.length >= 8) out += ' ' + d.slice(7, 9);
    if (d.length >= 10) out += ' ' + d.slice(9, 11);
    return out;
  }
  document.querySelectorAll('[data-lead-form] input[name="phone"]').forEach((input) => {
    input.addEventListener('focus', () => { if (!input.value) input.value = '+7 '; });
    input.addEventListener('input', () => { input.value = fmtPhone(input.value); });
    input.addEventListener('blur', () => { if (input.value.replace(/\D/g,'').length <= 1) input.value = ''; });
    input.addEventListener('paste', (e) => { e.preventDefault(); input.value = fmtPhone((e.clipboardData||window.clipboardData).getData('text')); });
  });

  // Отправка формы (ajax) → /api/lead.php
  document.querySelectorAll('[data-lead-form]').forEach((form) => {
    const status = form.querySelector('[data-status]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      if (fd.get('website')) return;
      if (status) { status.hidden = false; status.className = 'form-status'; status.textContent = 'Отправляем…'; }
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          if (status) { status.className = 'form-status ok'; status.textContent = 'Спасибо! Получили заявку — свяжемся в ближайшее время.'; }
          form.reset();
          if (window.ym) window.ym(window.__ymId || 0, 'reachGoal', 'form_submit');
        } else { throw new Error(json.error || 'fail'); }
      } catch (err) {
        if (status) { status.className = 'form-status err'; status.textContent = 'Не удалось отправить. Напишите в WhatsApp или Telegram.'; }
      }
    });
  });

  // Аналитика открытия модалки
  document.querySelectorAll('[data-open-track]').forEach((b) => b.addEventListener('click', () => {
    if (window.ym) window.ym(window.__ymId || 0, 'reachGoal', 'open_lead_dialog');
  }));

  // Фолбэк Invoker Commands (modern-web-guidance)
  if (!('commandForElement' in HTMLButtonElement.prototype)) {
    document.querySelectorAll('button[commandfor][command]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = document.getElementById(btn.getAttribute('commandfor'));
        if (!(t instanceof HTMLDialogElement)) return;
        const c = btn.getAttribute('command');
        if (c === 'show-modal') t.showModal(); else if (c === 'close') t.close();
      });
    });
  }
  // Фолбэк light-dismiss <dialog closedby>
  const dlg = document.getElementById('v2-dialog');
  if (dlg && !('closedBy' in HTMLDialogElement.prototype)) {
    dlg.addEventListener('click', (e) => {
      if (e.target !== dlg) return;
      const r = dlg.getBoundingClientRect();
      const inside = r.top <= e.clientY && e.clientY <= r.top + r.height && r.left <= e.clientX && e.clientX <= r.left + r.width;
      if (!inside) dlg.close();
    });
  }
  // Синхронизация aria-invalid с :user-invalid (accessible-error-announcement)
  const sync = (el) => {
    if (!el || !el.matches || !el.matches('[data-v2-validate] input, [data-v2-validate] select')) return;
    el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
  };
  document.addEventListener('blur', (e) => sync(e.target), true);
  document.addEventListener('input', (e) => { if (e.target && e.target.hasAttribute && e.target.hasAttribute('aria-invalid')) sync(e.target); });
</script>
