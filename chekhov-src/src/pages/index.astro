---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import PriceTable from '../components/PriceTable.astro';
import Faq from '../components/Faq.astro';
import SubjectCard from '../components/SubjectCard.astro';
import { site } from '../data/site.ts';

const title = 'Репетитор по математике, информатике и физике в Чехове';
const description = 'Очные занятия в кабинете для школьников 5–11 классов. Подготовка к ОГЭ, ЕГЭ, контрольным и повышение успеваемости. Запись на диагностику.';

const faq = [
  {
    q: 'Где проходят занятия?',
    a: 'Очно в моём кабинете в Чехове. Точный адрес отправляю после записи на занятие. Кабинет находится в удобной транспортной доступности.',
  },
  {
    q: 'С какого класса берёте учеников?',
    a: 'Работаю со школьниками 5–11 классов: помогаю и с текущей программой, и с подготовкой к ОГЭ/ЕГЭ.',
  },
  {
    q: 'Сколько стоит занятие?',
    a: `Актуальные цены — на <a href="${site.basePath}/ceny/">странице «Цены»</a>. Стоимость зависит от класса, длительности и цели занятий. Первая диагностика — отдельным форматом.`,
  },
  {
    q: 'Как проходит первое занятие?',
    a: 'На первом занятии определяем уровень ученика, выявляем пробелы и составляем понятный план подготовки. Дальше — регулярные занятия с обратной связью родителям.',
  },
  {
    q: 'Можно ли заниматься онлайн?',
    a: 'Основной формат — очный, в кабинете. По опыту он эффективнее для большинства школьников.',
  },
  {
    q: 'Из каких городов и посёлков приезжают ученики?',
    a: `Помимо Чехова — ${site.serviceAreas.slice(1).join(', ')} и другие населённые пункты Чеховского городского округа.`,
  },
];
---
<Layout title={title} description={description}>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Чехов · очно в кабинете</span>
          <h1>Репетитор по математике, информатике и физике в Чехове</h1>
          <p class="lead">Очные занятия в кабинете для школьников 5–11 классов. Помогаю подготовиться к ОГЭ, ЕГЭ, контрольным и закрыть пробелы в знаниях.</p>
          <div class="tag-list" style="margin: 18px 0 24px;">
            <span class="tag">5–11 класс</span>
            <span class="tag">ОГЭ · ЕГЭ</span>
            <span class="tag">Индивидуально</span>
            <span class="tag">План занятий</span>
          </div>
          <div class="btn-row">
            <a class="btn btn-accent" href="#zayavka">Записаться на диагностику</a>
            <a class="btn btn-wa" href={site.whatsapp} target="_blank" rel="nofollow noopener" data-cta="whatsapp_hero">Написать в WhatsApp</a>
            <a class="btn btn-ghost" href={`${site.basePath}/ceny/`}>Посмотреть цены</a>
          </div>
        </div>
        <div class="placeholder-photo" style="background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.18); color: rgba(255,255,255,.7);">
          <div>
            <strong>Фото преподавателя или кабинета</strong><br/>
            <span class="todo" style="margin-top: 8px;">TODO</span> Замените на реальное фото<br/>(<code>public/images/hero.jpg</code>)
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Предметы -->
  <section>
    <div class="container">
      <span class="eyebrow">Что я преподаю</span>
      <h2>Три предмета — один преподаватель</h2>
      <p class="lead" style="max-width: 720px;">Одна точка ответственности: вы не ищете трёх разных репетиторов и не подстраиваете три разных графика. Программу веду системно.</p>
      <div class="grid grid-3" style="margin-top: 28px;">
        <SubjectCard
          title="Математика"
          href={`${site.basePath}/matematika/`}
          tagline="Алгебра, геометрия, подготовка к ОГЭ и ЕГЭ."
          bullets={[
            'Школьная программа 5–11 класс',
            'Подготовка к ОГЭ и ЕГЭ (база и профиль)',
            'Контрольные, диагностики, пробелы',
          ]}
          iconColor="#1f4a72"
        />
        <SubjectCard
          title="Информатика"
          href={`${site.basePath}/informatika/`}
          tagline="ОГЭ, ЕГЭ, Python и алгоритмы простым языком."
          bullets={[
            'ОГЭ и ЕГЭ по информатике',
            'Основы программирования и Python',
            'Логика, системы счисления, алгоритмы',
          ]}
          iconColor="#2c7a4b"
        />
        <SubjectCard
          title="Физика"
          href={`${site.basePath}/fizika/`}
          tagline="Механика, электричество, оптика — без зубрёжки."
          bullets={[
            'Физика 7–11 класс',
            'Подготовка к ОГЭ и ЕГЭ',
            'Решение задач, объяснение теории',
          ]}
          iconColor="#a85b0c"
        />
      </div>
    </div>
  </section>

  <!-- Кому подходят занятия -->
  <section class="section-soft">
    <div class="container">
      <span class="eyebrow">Кому подходят занятия</span>
      <h2>С какими задачами обращаются родители</h2>
      <div class="grid grid-2" style="margin-top: 24px;">
        <div class="card">
          <h3>Готовимся к ОГЭ или ЕГЭ</h3>
          <p>Ученикам 9 и 11 классов помогаю выстроить системную подготовку: разбираем структуру экзамена, типовые задания, решаем пробники и работаем над ошибками.</p>
        </div>
        <div class="card">
          <h3>Подтягиваем успеваемость</h3>
          <p>Когда оценки в школе ниже ожидаемых, разбираем именно те темы, где образовался пробел, и доводим до уверенного понимания.</p>
        </div>
        <div class="card">
          <h3>Закрываем пробелы прошлых лет</h3>
          <p>Часто проблема не в текущей теме, а в том, что не освоено что-то базовое. На диагностике это видно сразу — и план подготовки строится с учётом этого.</p>
        </div>
        <div class="card">
          <h3>Готовимся к контрольной</h3>
          <p>Точечные занятия перед важной контрольной или диагностикой. Разбираем темы блока, прорешиваем типовые задания.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Как проходит обучение -->
  <section>
    <div class="container">
      <span class="eyebrow">Как проходит обучение</span>
      <h2>От первой заявки до результата</h2>
      <div class="steps">
        <div class="step">
          <div class="step-n">1</div>
          <h3>Заявка</h3>
          <p>Вы оставляете заявку — я связываюсь, уточняю класс, предмет, цель и удобное время.</p>
        </div>
        <div class="step">
          <div class="step-n">2</div>
          <h3>Диагностика</h3>
          <p>На первом занятии в кабинете оцениваем текущий уровень ученика и находим пробелы.</p>
        </div>
        <div class="step">
          <div class="step-n">3</div>
          <h3>План занятий</h3>
          <p>Составляем индивидуальный план: темы, ритм, контрольные точки.</p>
        </div>
        <div class="step">
          <div class="step-n">4</div>
          <h3>Регулярные занятия</h3>
          <p>Очно, по расписанию. С обратной связью родителям по прогрессу.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Подготовка к ОГЭ и ЕГЭ -->
  <section class="section-soft">
    <div class="container">
      <span class="eyebrow">Экзамены</span>
      <h2>Подготовка к ОГЭ и ЕГЭ в Чехове</h2>
      <div class="grid grid-2" style="margin-top: 24px;">
        <a class="card link-card" href={`${site.basePath}/oge/`}>
          <h3>ОГЭ → 9 класс</h3>
          <p>Математика, информатика, физика. Разбор структуры экзамена, типовые задания, пробники, работа над ошибками.</p>
          <span class="more">Подробнее об ОГЭ →</span>
        </a>
        <a class="card link-card" href={`${site.basePath}/ege/`}>
          <h3>ЕГЭ → 11 класс</h3>
          <p>Профильная математика, информатика, физика. Подготовка с нуля или усиление — стратегия на год, разбор сложных заданий.</p>
          <span class="more">Подробнее о ЕГЭ →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Фото кабинета -->
  <section>
    <div class="container">
      <span class="eyebrow">Кабинет</span>
      <h2>Где проходят занятия</h2>
      <p class="lead" style="max-width: 720px;">Кабинет в Чехове, оборудованный всем необходимым для занятий: доска, рабочий стол, материалы для подготовки к экзаменам.</p>
      <div class="grid grid-3" style="margin-top: 24px;">
        <div class="placeholder-photo"><span><span class="todo">TODO</span> фото кабинета 1</span></div>
        <div class="placeholder-photo"><span><span class="todo">TODO</span> фото рабочего места</span></div>
        <div class="placeholder-photo"><span><span class="todo">TODO</span> фото материалов</span></div>
      </div>
      <p style="margin-top: 20px;">
        <a class="btn btn-ghost" href={`${site.basePath}/kabinet/`}>Подробнее о кабинете →</a>
      </p>
    </div>
  </section>

  <!-- Цены -->
  <section class="section-soft">
    <div class="container">
      <span class="eyebrow">Цены</span>
      <h2>Прозрачные цены — без сюрпризов</h2>
      <p class="lead" style="max-width: 720px;">Цены указаны открыто. Это экономит время и вам, и мне: вы сразу понимаете, подходит ли формат.</p>
      <div style="margin-top: 24px;">
        <PriceTable />
      </div>
      <p style="margin-top: 16px;">
        <a class="btn btn-ghost" href={`${site.basePath}/ceny/`}>Все варианты занятий →</a>
      </p>
    </div>
  </section>

  <!-- Отзывы -->
  <section>
    <div class="container">
      <span class="eyebrow">Отзывы</span>
      <h2>Что говорят родители и ученики</h2>
      <div class="grid grid-3" style="margin-top: 24px;">
        <div class="card">
          <p>«<span class="todo">TODO</span> Реальный отзыв родителя ученика 9 класса. Замените текст в <code>src/pages/index.astro</code> или подгружайте из админки.»</p>
          <p class="muted small">— Имя, класс ученика</p>
        </div>
        <div class="card">
          <p>«<span class="todo">TODO</span> Отзыв об опыте подготовки к ОГЭ/ЕГЭ — конкретный результат и впечатления.»</p>
          <p class="muted small">— Имя, класс ученика</p>
        </div>
        <div class="card">
          <p>«<span class="todo">TODO</span> Отзыв ученика, который подтянул успеваемость с тройки до уверенной четвёрки/пятёрки.»</p>
          <p class="muted small">— Имя, класс ученика</p>
        </div>
      </div>
      <p style="margin-top: 20px;">
        <a class="btn btn-ghost" href={`${site.basePath}/otzyvy/`}>Все отзывы →</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <Faq items={faq} />

  <!-- Заявка -->
  <LeadForm />

</Layout>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 24px; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
  .step {
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 22px;
  }
  .step-n {
    width: 36px; height: 36px;
    background: var(--c-accent);
    color: var(--c-primary);
    border-radius: 50%;
    display: grid; place-items: center;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .link-card { text-decoration: none; color: var(--c-text); transition: transform .15s ease, box-shadow .15s ease; }
  .link-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); text-decoration: none; }
  .link-card .more { display: inline-block; margin-top: 10px; color: var(--c-primary); font-weight: 600; }
</style>
