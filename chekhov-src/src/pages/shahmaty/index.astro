---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import PriceTable from '../../components/PriceTable.astro';
import Faq from '../../components/Faq.astro';
import { site } from '../../data/site.ts';

const title = 'Шахматы для детей в Чехове | Занятия с нуля, 5–17 лет';
const description = 'Занятия по шахматам в Чехове в нашем кабинете на ул. Московской, 87/1. С нуля и для тех, кто уже играет: дошкольники и школьники. Первое занятие — бесплатно.';

const faq = [
  { q: 'С какого возраста берёте на шахматы?', a: 'С 5–6 лет, если ребёнок уже уверенно считает до десяти и может удерживать внимание минут двадцать. Верхней границы нет: занимаются и старшеклассники — как ради разрядов, так и просто для удовольствия.' },
  { q: 'А если ребёнок совсем не умеет играть?', a: 'Это обычная ситуация, с неё начинают почти все. Первые занятия — как ходят фигуры, что такое шах и мат, простейшие ловушки. Ребёнок начинает играть партии целиком уже на первых встречах.' },
  { q: 'Нужно ли покупать доску?', a: 'Нет. Доски и часы есть в кабинете. Дома удобно закреплять на телефоне или планшете — подскажем, где именно, чтобы это была тренировка, а не бесконечные блиц-партии.' },
  { q: 'Шахматы правда помогают с математикой?', a: 'Помогают, но не магически. Общее у них одно: привычка просчитывать варианты и проверять себя до того, как сделан ход. Ребёнок, который научился останавливаться и думать за доской, реже делает импульсивные ошибки в задачах. Обещать за счёт шахмат рост оценок по математике мы не станем.' },
  { q: 'Готовите к турнирам и разрядам?', a: 'Да, если ребёнок этого хочет. Но это не обязательная цель: многие занимаются без всяких турниров, ради самой игры и умения думать.' },
];
---
<Layout title={title} description={description}>

  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Чехов · шахматы · очно</span>
          <h1>Шахматы для детей в Чехове</h1>
          <p class="lead">С нуля и для тех, кто уже играет. Дошкольники с 5–6 лет и школьники до 11 класса. Занятия очно, в нашем кабинете на ул. Московская, 87/1 — за настоящей доской, а не в приложении.</p>
          <div class="btn-row" style="margin-top: 20px;">
            <a class="btn btn-accent" href="#zayavka">Записаться на бесплатное занятие</a>
            <a class="btn btn-wa" href={site.whatsapp} target="_blank" rel="nofollow noopener" data-cta="whatsapp_hero">WhatsApp</a>
          </div>
        </div>
        <img class="media-photo" src="/images/kabinet/obshiy-vid.jpg" width="1280" height="962" loading="eager" fetchpriority="high" alt="Кабинет репетиторского центра «Эвриум» в Чехове, где проходят занятия по шахматам" />
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Как проходят занятия</h2>
      <div class="grid grid-2" style="margin-top: 22px;">
        <div class="card">
          <h3>Начинающие: с первого хода</h3>
          <p>Как ходят фигуры, что такое шах, мат и пат, почему нельзя выводить ферзя первым ходом. Ребёнок играет полные партии с первых занятий — разбирать правила без игры скучно и бессмысленно.</p>
        </div>
        <div class="card">
          <h3>Продолжающие: почему проигрываем</h3>
          <p>Разбираем сыгранные партии и ищем момент, где всё пошло не так. Типовые ошибки: зевки фигур, игра без плана, спешка в выигранной позиции.</p>
        </div>
        <div class="card">
          <h3>Дебют, миттельшпиль, эндшпиль</h3>
          <p>Базовые принципы вместо заучивания вариантов: развитие фигур, центр, безопасность короля. Простые эндшпили, которые решают исход большинства детских партий.</p>
        </div>
        <div class="card">
          <h3>Тактика</h3>
          <p>Вилки, связки, двойные удары, мат в один и два хода. Это тот навык, который быстрее всего даёт видимый результат: ребёнок начинает выигрывать у тех, кому раньше проигрывал.</p>
        </div>
        <div class="card">
          <h3>Игра с разбором</h3>
          <p>Часть занятия — партии с соперником своего уровня и с педагогом, с остановками и вопросом «а что будет, если...». Именно в этих остановках и происходит обучение.</p>
        </div>
        <div class="card">
          <h3>Турниры и разряды</h3>
          <p>Для тех, кто хочет соревноваться: как готовиться, как держать себя за доской, как переживать поражения. Обязательным это не делаем.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2>Зачем ребёнку шахматы</h2>
      <p>Честный ответ: прежде всего затем, что это интересная игра, в которую можно играть всю жизнь. Всё остальное — следствия, и они появляются не у всех и не сразу.</p>
      <p>Что действительно тренируется за доской: привычка просчитывать последствия хода до того, как рука его сделала; умение спокойно проигрывать и разбирать причину; способность полчаса удерживать внимание на одной задаче. Для дошкольника последнее часто оказывается ценнее всего остального — особенно перед школой.</p>
      <p>Чего мы обещать не будем: что шахматы сами по себе поднимут оценки по математике. Связь между ними есть, но она непрямая — через ту самую привычку думать до хода, а не после. Если нужна именно математика, честнее заниматься <a href={`${site.basePath}/matematika/`}>математикой</a>, а шахматы оставить как игру.</p>

      <h3 style="margin-top: 28px;">Смотрите также</h3>
      <ul>
        <li><a href={`${site.basePath}/matematika/`}>Математика</a> — 2–11 класс, ОГЭ и ЕГЭ.</li>
        <li><a href={`${site.basePath}/kabinet/`}>Кабинет</a> — где проходят занятия и как нас найти.</li>
        <li><a href={`${site.basePath}/ceny/`}>Цены</a> — все форматы и стоимость.</li>
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Цены</h2>
      <p class="muted" style="max-width: 720px;">Шахматы идут по общему прайсу центра. Первое занятие — знакомство и оценка уровня — бесплатное и ни к чему не обязывает.</p>
      <div style="margin-top: 18px;">
        <PriceTable />
      </div>
    </div>
  </section>

  <Faq items={faq} title="Частые вопросы о занятиях по шахматам" />

  <LeadForm subject="shahmaty" />

</Layout>
