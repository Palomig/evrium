---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Faq from '../../components/Faq.astro';
import { site } from '../../data/site.ts';

const title = 'Как попасть в 10 класс: отбор, баллы ОГЭ и подготовка в Чехове';
const description = 'В 10 класс проходит меньше половины девятиклассников: отбор по баллам ОГЭ, оценкам и портфолио. Разбираем правила и повышаем шансы ребёнка. Бесплатная диагностика уровня в Чехове.';

// Все цифры — со ссылками на источники в тексте страницы. Проверено 11.08.2026.
// Меняются ежегодно: перед новым сезоном сверять статистику и рекомендованные баллы.
const faq = [
  {
    q: 'Могут ли вообще не взять в 10 класс?',
    a: 'В свою школу — да, если в ней нет свободных мест или ребёнок не прошёл индивидуальный отбор в профильный класс. Но без места он не останется: если отбор не пройден, органы местного самоуправления обязаны предоставить место в классе универсального профиля либо в другой территориально доступной школе. Это разъяснило Минпросвещения в июле 2026 года.',
  },
  {
    q: 'Законно ли, что школа устраивает конкурс?',
    a: 'Да. Часть 5 статьи 67 закона «Об образовании в РФ» допускает индивидуальный отбор при приёме в классы с углублённым изучением предметов и для профильного обучения — в порядке, который устанавливает регион. В Подмосковье такой порядок утверждён распоряжением Министерства образования Московской области от 12.12.2025 № Р-1026.',
  },
  {
    q: 'Что смотрят при отборе, кроме ОГЭ?',
    a: 'Обычно средний балл аттестата, годовые отметки по профильным предметам за 9 класс, результаты защиты индивидуального проекта и портфолио — олимпиады и конкурсы за последние два года. Точный список и минимальные баллы каждая школа обязана заранее опубликовать у себя на сайте.',
  },
  {
    q: 'Сколько баллов ОГЭ по математике нужно для физмат-класса?',
    a: 'Ориентир для физико-математического профиля — 19 первичных баллов из 31, причём не менее 7 из них за геометрию. Для естественнонаучного — 18 баллов, из них 6 за геометрию. Это рекомендованные ориентиры, а не федеральная норма: конкретные пороги школа устанавливает сама и публикует в правилах приёма.',
  },
  {
    q: 'Когда проходит отбор?',
    a: 'Обычно в первой половине июля, сразу после результатов ОГЭ, — например, приём заявлений с 1 по 21 июля. Точные даты школа публикует не позднее чем за 10 дней до начала процедуры. Готовиться в июле уже поздно: оценивают то, что ребёнок набрал за год и на экзамене.',
  },
  {
    q: 'Вы гарантируете, что ребёнок поступит в 10 класс?',
    a: 'Нет, и никто не может: решение принимает приёмная комиссия школы по своим критериям, а мест меньше, чем желающих. Мы влияем на то, что зависит от подготовки — на балл ОГЭ и годовые оценки, с которыми ребёнок придёт на отбор. Ученик с 19 баллами по математике проходит конкурс чаще, чем ученик с 12. Если до отбора остался месяц и поднять балл уже нереально, мы скажем об этом прямо.',
  },
  {
    q: 'Когда начинать готовиться?',
    a: 'Оптимально — с начала 9 класса, минимально приемлемо — с осени. Дело не только в экзамене: в рейтинг идут годовые отметки за 9 класс, и их нельзя исправить в мае. Если у ребёнка сейчас тройки по математике, за пару месяцев до ОГЭ поднять и оценку, и балл одновременно почти нереально.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout title={title} description={description} extraSchema={faqSchema}>

  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Чехов · 9 класс · подготовка</span>
          <h1>В 10 класс проходит меньше половины девятиклассников</h1>
          <p class="lead">Место в профильном классе теперь разыгрывается по конкурсу: баллы ОГЭ, годовые оценки, портфолио. Шансы ребёнка — это не лотерея, их можно посчитать и повысить за год. Начинается всё с бесплатной диагностики: показываем, сколько баллов он берёт сейчас и на какой профиль этого хватает.</p>
          <div class="btn-row" style="margin-top: 20px;">
            <a class="btn btn-accent" href="#zayavka">Узнать реальные шансы ребёнка</a>
            <a class="btn btn-wa" href={site.whatsapp} target="_blank" rel="nofollow noopener" data-cta="whatsapp_hero">WhatsApp</a>
          </div>
        </div>
        <img class="media-photo" src="/images/kabinet/zanyatie.jpg" width="1280" height="964" loading="eager" fetchpriority="high" alt="Занятие с девятиклассниками в кабинете «Эвриум» в Чехове — подготовка к ОГЭ" />
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Что происходит</h2>
      <div class="grid grid-3" style="margin-top: 22px;">
        <div class="card">
          <h3>63%</h3>
          <p>девятиклассников в 2025 году ушли в колледжи и техникумы — рекорд за полвека, около 1,3 млн человек.</p>
        </div>
        <div class="card">
          <h3>43,5%</h3>
          <p>доля девятиклассников, поступающих в 10 класс, по оценке РАНХиГС. Меньше половины.</p>
        </div>
        <div class="card">
          <h3>~70%</h3>
          <p>прогноз доли уходящих в колледжи в 2026 году. Тенденция усиливается.</p>
        </div>
      </div>
      <p style="margin-top: 24px; max-width: 820px;">Часть семей выбирает колледж осознанно — это нормальный путь. Но значительная часть уходит не потому, что хотела, а потому, что в десятый не взяли: мест меньше, чем девятиклассников, и попадают туда по конкурсу.</p>
      <p style="max-width: 820px;">Это фон, на котором конкурирует ваш ребёнок. Он ничего не говорит лично о нём — но означает, что решение принимается не в мае 11 класса, а в 9-м, и принимают его баллы.</p>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2>Как устроен отбор — по закону</h2>
      <p>Школа не может отказать ребёнку в среднем образовании как таковом. Но она вправе отказать в приёме именно к себе при отсутствии свободных мест, а в профильный класс — если ученик не прошёл индивидуальный отбор. Такую возможность даёт часть 5 статьи 67 закона «Об образовании в Российской Федерации»: отбор допускается для классов с углублённым изучением предметов и для профильного обучения, в порядке, который устанавливает регион. Для Подмосковья это распоряжение Министерства образования Московской области от 12 декабря 2025 года № Р-1026.</p>
      <p>Что при этом важно понимать про формулировку «место дадут». Оно действительно найдётся: в июле 2026 года Минпросвещения разъяснило, что при непрохождении конкурсного отбора органы местного самоуправления обязаны предоставить место в классе универсального профиля либо в другой территориально доступной школе. Но <strong>это место — не то, за которое шла борьба</strong>: не профильный класс и, возможно, не своя школа.</p>
      <p>То есть на кону не «останется ли ребёнок без образования», а гораздо более приземлённая вещь: продолжит ли он учиться в сильном классе со своими одноклассниками и с углублённой математикой — или поедет в универсальный класс в другой конец города. Именно за это и идёт конкуренция, и именно на это можно повлиять за год.</p>

      <h3 style="margin-top: 32px;">Что кладут в рейтинг</h3>
      <ul>
        <li><strong>Результаты ОГЭ</strong> — по обязательным предметам и по профильным для выбранного направления.</li>
        <li><strong>Средний балл аттестата</strong> и отдельно — годовые отметки за 9 класс по предметам, которые будут изучаться углублённо.</li>
        <li><strong>Аттестат с отличием</strong> — как отдельное преимущество.</li>
        <li><strong>Индивидуальный проект</strong> — результат его защиты в 9 классе.</li>
        <li><strong>Портфолио</strong> — победы и призовые места в олимпиадах и конкурсах за последние два года.</li>
      </ul>
      <p>Конкретный набор критериев, их вес и минимальные баллы школа обязана заранее прописать в своих правилах приёма и выложить на сайте. Сроки процедуры публикуются не позднее чем за 10 дней до её начала — обычно отбор идёт в первой половине июля, сразу после результатов ОГЭ.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Сколько баллов нужно на самом деле</h2>
      <p style="max-width: 820px;">Для аттестата по математике достаточно 8 первичных баллов из 31 — при условии, что минимум 2 из них получены за геометрию. Для профильного класса планка совсем другая:</p>

      <div class="grid grid-3" style="margin-top: 22px;">
        <div class="card">
          <h3>Физико-математический</h3>
          <p><strong>19 баллов</strong> из 31, из них <strong>не менее 7 за геометрию</strong>.</p>
        </div>
        <div class="card">
          <h3>Естественнонаучный</h3>
          <p><strong>18 баллов</strong>, из них <strong>6 за геометрию</strong>.</p>
        </div>
        <div class="card">
          <h3>Экономический</h3>
          <p><strong>18 баллов</strong>, из них <strong>5 за геометрию</strong>.</p>
        </div>
      </div>

      <p style="margin-top: 24px; max-width: 820px;">Это рекомендованные ориентиры, а не федеральная норма — свои пороги школа устанавливает сама. Но обратите внимание на закономерность: <strong>требования к геометрии растут быстрее, чем общий балл</strong>. Разница между аттестатом и физмат-классом по математике в целом — 11 баллов, а по геометрии — в три с половиной раза.</p>

      <div class="card" style="margin-top: 24px; max-width: 820px;">
        <h3>Почему это бьёт именно по геометрии</h3>
        <p>Геометрия — самая проваливаемая часть ОГЭ по математике. Её проходят в школе быстрее алгебры, задачи требуют не подстановки в формулу, а построения рассуждения, и «нарешать» их за месяц не получается. Ученик, у которого твёрдая четвёрка по алгебре и провал по геометрии, набирает достаточно для аттестата — и не проходит в профильный класс.</p>
        <p>С этого мы и начинаем работу с девятиклассниками: смотрим, сколько баллов ребёнок реально берёт из геометрической части, а не общий результат пробника.</p>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2>Как мы повышаем шансы</h2>
      <p style="max-width: 820px;">Мы не влияем на то, сколько мест выделит школа и какие пороги она поставит. Мы влияем ровно на одну вещь — на балл, с которым ребёнок придёт на отбор. Это и есть та часть, которая зависит от вас.</p>
      <div class="grid grid-2" style="margin-top: 22px;">
        <div class="card">
          <h3>1. Диагностика — бесплатно</h3>
          <p>Ученик пишет самостоятельную работу, мы разбираем ошибки. На выходе — понятная картина: сколько баллов он берёт сейчас, отдельно по алгебре и отдельно по геометрии, и какого профиля хватает с таким результатом.</p>
        </div>
        <div class="card">
          <h3>2. План под конкретный класс</h3>
          <p>Отталкиваемся не от «подтянуть математику», а от требований школы, куда ребёнок собирается. Разрыв между текущим баллом и нужным превращается в список тем и сроки.</p>
        </div>
        <div class="card">
          <h3>3. Геометрия отдельным блоком</h3>
          <p>Не «после алгебры, если останется время», а параллельно с первого месяца. Именно она чаще всего решает, пройдёт ребёнок отбор или нет.</p>
        </div>
        <div class="card">
          <h3>4. Годовые оценки — тоже задача</h3>
          <p>В рейтинг идут отметки за 9 класс, а не только экзамен. Поэтому держим и текущую успеваемость: контрольные, домашние, ответы у доски.</p>
        </div>
      </div>
      <p style="margin-top: 24px;">Занимаемся <a href={`${site.basePath}/matematika/`}>математикой</a>, <a href={`${site.basePath}/fizika/`}>физикой</a> и <a href={`${site.basePath}/informatika/`}>информатикой</a> — то есть закрываем профильные предметы для инженерных, физико-математических и IT-направлений. Подробнее о самом экзамене — на странице <a href={`${site.basePath}/oge/`}>подготовки к ОГЭ</a>.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="card" style="max-width: 820px; margin-bottom: 24px;">
        <h3>Чего мы не обещаем</h3>
        <p>Никаких гарантий поступления мы не даём — и не поверьте тому, кто даст. Решение принимает приёмная комиссия школы по своим критериям, а мест в профильных классах меньше, чем желающих. Гарантировать результат конкурса не может никто.</p>
        <p>Что мы делаем — повышаем вероятность: поднимаем балл ОГЭ, вытягиваем геометрию, держим годовые оценки. Ребёнок с 19 баллами и семью за геометрию проходит отбор чаще, чем ребёнок с 12 баллами. Это статистика, а не обещание.</p>
        <p>И честное следствие: если до отбора остался месяц, мы так и скажем — сильно поднять балл уже не выйдет. Браться за работу, которая не даст результата, ради оплаты нам неинтересно.</p>
      </div>

      <div class="card" style="max-width: 820px;">
        <h3>Когда начинать</h3>
        <p>Сентябрь–октябрь 9 класса — рабочий вариант: есть год на геометрию и на оценки. Январь — уже догоняющий режим, но подтянуть балл реально. Апрель — можно рассчитывать на аттестат, но не на конкурс в сильный профиль: годовые отметки к этому моменту уже сложились.</p>
        <p>Если ваш ребёнок сейчас в 9 классе — самое время посмотреть на его реальный уровень, а не на школьные оценки. Диагностика бесплатная и ни к чему не обязывает.</p>
        <p style="margin-top: 16px;"><a class="btn btn-accent" href="#zayavka">Записаться на бесплатную диагностику</a></p>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2>Источники</h2>
      <ul class="sources">
        <li><a href="https://ria.ru/20260714/shkola-2104671533.html" target="_blank" rel="noopener nofollow">Минпросвещения разъяснило правила приёма в десятый класс</a> — РИА Новости, 14 июля 2026.</li>
        <li><a href="https://ria.ru/obrazovanie/bally-oge-po-matematike/" target="_blank" rel="noopener nofollow">Баллы ОГЭ по математике: минимальные, максимальные и рекомендованные для профильных классов</a> — РИА Новости.</li>
        <li><a href="https://publication.pravo.gov.ru/document/5001202512170005" target="_blank" rel="noopener nofollow">Распоряжение Министерства образования Московской области от 12.12.2025 № Р-1026</a> — порядок индивидуального отбора.</li>
        <li><a href="https://regions.ru/obrazovanie/kak-budut-brat-v-10-klass-v-2026-godu-novye-pravila-postuplenija-posle-oge" target="_blank" rel="noopener nofollow">Как будут брать в 10 класс в 2026 году</a> — REGIONS.RU.</li>
        <li><a href="https://news.ru/society/rekordnoe-chislo-uchenikov-ushli-iz-shkol-posle-devyatogo-klassa-v-etom-godu" target="_blank" rel="noopener nofollow">Рекордное число учеников ушло из школ после девятого класса в 2025 году</a> — News.ru.</li>
      </ul>
      <p class="muted small" style="margin-top: 14px;">Данные проверены 11 августа 2026 года. Правила приёма и пороговые баллы обновляются ежегодно — перед подачей документов сверяйтесь с правилами приёма на сайте конкретной школы.</p>
    </div>
  </section>

  <Faq items={faq} title="Частые вопросы о поступлении в 10 класс" />

  <LeadForm subject="matematika" goal="oge" />

</Layout>

<style>
  .grid-3 .card h3 { font-size: 28px; margin-bottom: 6px; }
  .sources { max-width: 820px; }
  .sources li { margin-bottom: 8px; }
</style>
