---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site } from '../../data/site.ts';

const title = `Отзывы — ${site.centerName}, репетиторский центр в Чехове`;
const description = `Отзывы родителей и учеников о занятиях в ${site.centerName} — репетиторском центре в Чехове. Подготовка к ОГЭ, ЕГЭ, успеваемость.`;
---
<Layout title={title} description={description}>
  <section>
    <div class="container">
      <span class="eyebrow">Отзывы</span>
      <h1>Отзывы родителей и учеников</h1>
      <p class="lead" style="max-width: 720px;">Что говорят семьи из Чехова и окрестностей после подготовки к ОГЭ, ЕГЭ или подтягивания успеваемости. Отзывы ниже подгружаются напрямую с нашей карточки в Яндекс.Картах — без правок с нашей стороны.</p>

      <div class="reviews-widget" style="margin-top: 32px;">
        <iframe
          title="Отзывы об Эвриум на Яндекс.Картах"
          src={`https://yandex.ru/maps-reviews-widget/${site.yandexOrgId}?comments`}
          loading="lazy"
        ></iframe>
        <a class="reviews-widget__source" href={site.mapUrl} target="_blank" rel="noopener nofollow">
          {site.centerName} на Яндекс.Картах — оставить отзыв
        </a>
      </div>

      <div class="card" style="margin-top: 32px;">
        <h3>Оставить отзыв</h3>
        <p class="muted" style="margin-bottom: 12px;">Если вы занимались у нас — будем благодарны за честный отзыв. Это помогает другим родителям выбрать репетитора.</p>
        <p><a class="btn" href={site.mapUrl} target="_blank" rel="noopener nofollow">Написать отзыв в Яндекс.Картах →</a></p>
      </div>
    </div>
  </section>

  <LeadForm />
</Layout>

<style>
  .reviews-widget {
    max-width: 760px;
  }
  .reviews-widget iframe {
    width: 100%;
    height: 620px;
    border: 1px solid #e6e6e6;
    border-radius: 12px;
    box-sizing: border-box;
  }
  .reviews-widget__source {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.9em;
    color: var(--muted, #667);
  }
</style>
