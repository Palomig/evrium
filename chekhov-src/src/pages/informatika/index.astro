---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import PriceTable from '../../components/PriceTable.astro';
import Faq from '../../components/Faq.astro';
import { site } from '../../data/site.ts';

const title = 'Репетитор по информатике в Чехове | ОГЭ, ЕГЭ, Python';
const description = 'Очные занятия по информатике в Чехове в нашем кабинете на ул. Московской, 87/1. ОГЭ, ЕГЭ, Python, алгоритмы, системы счисления, логика. 2–11 классы.';

const faq = [
  { q: 'Готовите к ЕГЭ по информатике на компьютере?', a: 'Да. ЕГЭ по информатике сдаётся в компьютерном формате — на занятиях тренируем работу в той же среде, с теми же инструментами.' },
  { q: 'С какого класса можно изучать Python?', a: 'Базовый Python можно с 6–7 класса. Для подготовки к ЕГЭ — с 9–10 класса. Программа подстраивается под уровень.' },
  { q: 'Берёте «с нуля»?', a: 'Да. Многие ученики приходят без опыта программирования — это нормально. Начинаем с основ.' },
  { q: 'А если ребёнок только начинает в школе и пока не понимает информатику?', a: 'Помогаем разобраться со школьной программой — двоичная система, логика, базовые алгоритмы, работа с таблицами.' },
];
---
<Layout title={title} description={description}>

  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Чехов · информатика · очно</span>
          <h1>Репетитор по информатике в Чехове</h1>
          <p class="lead">ОГЭ и ЕГЭ по информатике, основы программирования, Python, алгоритмы. Для школьников 2–11 классов — индивидуально и понятно. Очно в нашем кабинете на ул. Московская, 87/1.</p>
          <div class="btn-row" style="margin-top: 20px;">
            <a class="btn btn-accent" href="#zayavka">Записаться на диагностику</a>
            <a class="btn btn-wa" href={site.whatsapp} target="_blank" rel="nofollow noopener" data-cta="whatsapp_hero">WhatsApp</a>
          </div>
        </div>
        <div class="placeholder-photo" style="background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.18); color: rgba(255,255,255,.7);">
          <span><span class="todo">TODO</span> фото рабочего места: ноутбук, среда программирования</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Что входит в занятия по информатике</h2>
      <div class="grid grid-2" style="margin-top: 22px;">
        <div class="card">
          <h3>Школьная информатика</h3>
          <p>Программа 2–11 классов. Двоичная система счисления, логика, работа с таблицами, базовые алгоритмы — то, что спрашивают в школе.</p>
        </div>
        <div class="card">
          <h3>Подготовка к ОГЭ</h3>
          <p>Структура ОГЭ по информатике, типовые задания, работа в реальной среде. Прорешиваем пробники, разбираем ошибки.</p>
        </div>
        <div class="card">
          <h3>Подготовка к ЕГЭ</h3>
          <p>Компьютерный формат экзамена, программирование, обработка данных. Прицельно тренируем сложные задания второй части.</p>
        </div>
        <div class="card">
          <h3>Программирование и Python</h3>
          <p>Основы Python: переменные, циклы, условия, функции, работа со строками и списками. Затем — алгоритмы, обработка данных, подготовка к олимпиадам.</p>
        </div>
        <div class="card">
          <h3>Алгоритмы и логика</h3>
          <p>Сортировки, поиск, рекурсия, базовые структуры данных. Систематично, с понятными объяснениями и тренировкой на задачах.</p>
        </div>
        <div class="card">
          <h3>Помощь с домашними заданиями</h3>
          <p>Если в школе задают, а ребёнок не понимает — разбираем вместе. Цель — не «решить за», а научить.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2>Очные занятия по информатике в Чехове</h2>
      <p>Информатику часто проще преподавать очно: можно сразу увидеть, где ученик «застрял» в коде, объяснить на бумаге и потом сразу же запустить программу. На дистанционке это занимает в разы больше времени.</p>
      <p>Все занятия — только очно в нашем кабинете в Чехове на ул. Московская, 87/1. Подробности — <a href={`${site.basePath}/kabinet/`}>на странице о кабинете</a>.</p>

      <h3 style="margin-top: 28px;">Смежные страницы</h3>
      <ul>
        <li><a href={`${site.basePath}/oge/`}>Подготовка к ОГЭ</a> — общая страница по экзамену.</li>
        <li><a href={`${site.basePath}/ege/`}>Подготовка к ЕГЭ</a> — программа на год.</li>
        <li><a href={`${site.basePath}/matematika/`}>Математика</a> — частый «соседний» предмет.</li>
        <li><a href={`${site.basePath}/ceny/`}>Цены</a>.</li>
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Цены</h2>
      <PriceTable />
    </div>
  </section>

  <Faq items={faq} title="Частые вопросы об информатике" />

  <LeadForm subject="informatika" />

</Layout>
