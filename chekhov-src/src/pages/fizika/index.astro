---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import PriceTable from '../../components/PriceTable.astro';
import Faq from '../../components/Faq.astro';
import { site } from '../../data/site.ts';

const title = 'Репетитор по физике в Чехове | ОГЭ, ЕГЭ, школьная программа';
const description = 'Очные занятия по физике в Чехове в нашем кабинете на ул. Московской, 87/1. Механика, электричество, оптика, молекулярная физика. ОГЭ, ЕГЭ, 7–11 класс.';

const faq = [
  { q: 'Дети часто не понимают физику с 7 класса. Что с этим делать?', a: 'Чаще всего проблема — в математической базе и в том, что в школе быстро прошли «механику». На занятиях возвращаемся к фундаменту, доводим до понимания и только потом идём дальше.' },
  { q: 'Готовите к ЕГЭ по физике?', a: 'Да. ЕГЭ по физике — одно из основных направлений работы центра: механика, электродинамика, МКТ и термодинамика, оптика, квантовая физика.' },
  { q: 'Помогаете решать задачи?', a: 'Решение задач — ядро занятий. Учим не «угадывать формулу», а разбирать ситуацию по физическим законам.' },
  { q: 'С 7 класса берёте?', a: 'Да. Физика 7–8 класс — лучший возраст, чтобы заложить базу, без которой 9–11 класс превращается в зубрёжку.' },
];
---
<Layout title={title} description={description}>

  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Чехов · физика · очно</span>
          <h1>Репетитор по физике в Чехове</h1>
          <p class="lead">Школьная программа 7–11 класса, подготовка к ОГЭ и ЕГЭ. Механика, электричество, оптика, молекулярная физика — без зубрёжки, с пониманием. Очно в нашем кабинете на ул. Московская, 87/1.</p>
          <div class="btn-row" style="margin-top: 20px;">
            <a class="btn btn-accent" href="#zayavka">Записаться на диагностику</a>
            <a class="btn btn-wa" href={site.whatsapp} target="_blank" rel="nofollow noopener" data-cta="whatsapp_hero">WhatsApp</a>
          </div>
        </div>
        <img class="media-photo" src="/images/kabinet/doska.jpg" width="1280" height="960" loading="lazy" alt="Доска с разбором задачи по физике (кинематика) в кабинете «Эвриум» в Чехове" />
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Темы и направления</h2>
      <div class="grid grid-2" style="margin-top: 22px;">
        <div class="card">
          <h3>Механика</h3>
          <p>Кинематика, динамика, законы Ньютона, импульс, энергия, статика. Фундамент, без которого остальные разделы трудно понять.</p>
        </div>
        <div class="card">
          <h3>Молекулярная физика и термодинамика</h3>
          <p>МКТ, газовые законы, теплоёмкость, первое и второе начала термодинамики. Разбираем задачи и графики.</p>
        </div>
        <div class="card">
          <h3>Электричество и магнетизм</h3>
          <p>Закон Кулона, цепи постоянного тока, магнитное поле, электромагнитная индукция. С опорой на задачи школьной программы и экзаменов.</p>
        </div>
        <div class="card">
          <h3>Оптика и волны</h3>
          <p>Геометрическая и волновая оптика, колебания, звук, интерференция. Часто становится «тёмной зоной» — у нас становится понятной.</p>
        </div>
        <div class="card">
          <h3>Подготовка к ОГЭ</h3>
          <p>Структура ОГЭ по физике, типовые задания, пробники, работа над ошибками. Подробнее — на <a href={`${site.basePath}/oge/`}>странице об ОГЭ</a>.</p>
        </div>
        <div class="card">
          <h3>Подготовка к ЕГЭ</h3>
          <p>Стратегия на год, разбор сложных заданий второй части, тренировка скорости. Подробнее — на <a href={`${site.basePath}/ege/`}>странице о ЕГЭ</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2>Почему физика «не идёт» — и что мы с этим делаем</h2>
      <p>В Чехове к нам часто приходят семиклассники и восьмиклассники с фразой «не понимаю физику». Реальные причины почти всегда одни и те же: пропустили математический аппарат (особенно работу с формулами и единицами измерения), не разобрались с механикой как фундаментом, или зубрят формулы вместо понимания, что происходит в задаче.</p>
      <p>На занятиях мы методично возвращаемся к этим точкам, доводим базу до уверенности и идём дальше. Это требует терпения, но даёт устойчивый результат, который виден в школьных оценках, на ОГЭ и на ЕГЭ.</p>

      <h3 style="margin-top: 28px;">Перелинковка</h3>
      <ul>
        <li><a href={`${site.basePath}/matematika/`}>Математика</a> — часто нужна параллельно для уверенности в формулах.</li>
        <li><a href={`${site.basePath}/oge/`}>ОГЭ</a>, <a href={`${site.basePath}/ege/`}>ЕГЭ</a>.</li>
        <li><a href={`${site.basePath}/ceny/`}>Цены</a>, <a href={`${site.basePath}/kabinet/`}>кабинет</a>.</li>
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Цены</h2>
      <PriceTable />
    </div>
  </section>

  <Faq items={faq} title="Частые вопросы о занятиях по физике" />

  <LeadForm subject="fizika" />

</Layout>
