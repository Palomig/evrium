<script>
  // Открытие/закрытие нативного <dialog> по кнопкам [data-open-lead]
  const dialog = document.getElementById('tp-lead-dialog') as HTMLDialogElement | null;
  if (dialog) {
    document.querySelectorAll('[data-open-lead]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
        if (window.ym) window.ym(window.__ymId || 0, 'reachGoal', 'open_lead_dialog');
      });
    });
    // Клик по подложке закрывает модал
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
