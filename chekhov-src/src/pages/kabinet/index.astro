---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site } from '../../data/site.ts';

const title = `Кабинет — ${site.centerName}, репетиторский центр в Чехове`;
const description = 'Наш кабинет в Чехове на ул. Московская, 87/1 — для очных занятий по математике, информатике и физике. Доска, рабочие столы, материалы для подготовки к ОГЭ и ЕГЭ.';
---
<Layout title={title} description={description}>
  <section>
    <div class="container">
      <span class="eyebrow">Кабинет</span>
      <h1>Где проходят занятия</h1>
      <p class="lead" style="max-width: 760px;">Наш кабинет в Чехове на ул. Московской, 87/1 — оборудованное пространство для занятий: доска, рабочие столы, материалы для подготовки к экзаменам, ноутбук для занятий по информатике. Все занятия центра проходят только здесь.</p>

      <div class="grid grid-3" style="margin-top: 28px;">
        <img class="media-photo" src="/images/kabinet/obshiy-vid.jpg" width="1280" height="962" loading="lazy" alt="Общий вид кабинета репетиторского центра «Эвриум» в Чехове со столами для занятий" />
        <img class="media-photo" src="/images/kabinet/doska.jpg" width="1280" height="960" loading="lazy" alt="Рабочее место с доской: разбор задачи по физике в кабинете «Эвриум» в Чехове" />
        <img class="media-photo" src="/images/kabinet/zanyatie.jpg" width="1280" height="964" loading="lazy" alt="Занятие в кабинете репетиторского центра «Эвриум» в Чехове — ученики за партами" />
      </div>

      <div class="grid grid-2" style="margin-top: 40px;">
        <div class="card">
          <h3>Адрес и как добраться</h3>
          <p>{site.addressPublic}</p>
          <p class="muted">Кабинет в Чехове в удобной транспортной доступности — пешком от центра и от общественного транспорта.</p>
          <p>
            <a class="btn btn-ghost" href={site.mapUrl} target="_blank" rel="noopener nofollow">Показать на Яндекс.Картах →</a>
          </p>
          <p><strong>Как найти:</strong> вход слева, чёрная дверь. Поднимайтесь на второй этаж.</p>
        </div>
        <div class="card">
          <h3>Парковка</h3>
          <p>Парковка есть на территории — можно подъехать и оставить машину, пока идёт занятие.</p>
        </div>
        <div class="card">
          <h3>Можно ли родителю подождать</h3>
          <p>Да. Если ребёнок маленький или вы хотите присутствовать на первом занятии — это нормально. Согласуем заранее.</p>
        </div>
        <div class="card">
          <h3>График занятий</h3>
          <p>Ежедневно с {site.openingHours.opens} до {site.openingHours.closes}. Удобное время фиксируем сразу при записи.</p>
        </div>
      </div>

      <div class="card" style="margin-top: 24px;">
        <h3>Правила посещения</h3>
        <ul>
          <li>Приходите на занятие за 5 минут до начала</li>
          <li>Сменка в холодное время года</li>
          <li>Телефоны на занятии — на беззвучном режиме</li>
          <li>Если опаздываете или не сможете прийти — предупредите заранее</li>
        </ul>
      </div>
    </div>
  </section>

  <LeadForm />
</Layout>
