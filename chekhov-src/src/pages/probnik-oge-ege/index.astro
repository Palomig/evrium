---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import Faq from '../../components/Faq.astro';
import { site } from '../../data/site.ts';

const title = 'Бесплатный пробник ОГЭ и ЕГЭ по математике в Чехове | Эвриум';
const description = 'Напишите пробный ОГЭ или ЕГЭ бесплатно в нашем кабинете в Чехове. Преподаватель проверяет работу вручную и даёт разбор: сколько баллов, где теряются и что делать дальше.';

const faq = [
  {
    q: 'Правда бесплатно? В чём подвох?',
    a: 'Подвоха нет. Проверка работы занимает у преподавателя время, но так мы знакомимся с учеником и понимаем, сможем ли помочь. Записываться на занятия после пробника вы не обязаны — разбор и рекомендации ваши в любом случае.',
  },
  {
    q: 'Сколько это занимает?',
    a: 'Сама работа — по договорённости: кому-то нужен полный вариант, кому-то достаточно части, чтобы увидеть картину. Разбор с преподавателем — отдельная встреча, обычно 30–40 минут. Точное время согласуем, когда вы оставите заявку.',
  },
  {
    q: 'Что ребёнок получит на руки?',
    a: 'Проверенную работу с пометками, свой балл и разбор: какие темы провалены, где ошибки по невнимательности, а где реальное непонимание. Для девятиклассников отдельно считаем баллы за геометрическую часть — именно она обычно решает, хватит ли на профильный класс.',
  },
  {
    q: 'А если результат окажется плохим?',
    a: 'Это и есть смысл затеи: узнать реальное положение дел за месяцы до экзамена, а не в июне. Плохой результат в августе — это просто много времени на исправление. Ругать ребёнка мы не будем, это не наша работа.',
  },
  {
    q: 'Нужно ли готовиться к пробнику?',
    a: 'Наоборот, не нужно. Готовая к экзамену работа не покажет реальных пробелов. Приходите как есть — нам нужна честная картина, а не красивая.',
  },
  {
    q: 'Что взять с собой?',
    a: 'Ручку и, если есть, результаты прошлых пробников или школьных контрольных. Всё остальное — бланки, черновики, справочные материалы — у нас. Телефон на время работы придётся убрать: условия как на настоящем экзамене.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout title={title} description={description} extraSchema={faqSchema}>

  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Чехов · ОГЭ и ЕГЭ · бесплатно</span>
          <h1>Напишите пробный ОГЭ или ЕГЭ бесплатно</h1>
          <p class="lead">Школьные оценки не показывают, сколько баллов ребёнок наберёт на экзамене. Пробник показывает. Ученик пишет работу в нашем кабинете, преподаватель проверяет её вручную и объясняет, где теряются баллы и что с этим делать. Бесплатно и без обязательств.</p>
          <div class="btn-row" style="margin-top: 20px;">
            <a class="btn btn-accent" href="#zayavka">Записаться на пробник</a>
            <a class="btn btn-wa" href={site.whatsapp} target="_blank" rel="nofollow noopener" data-cta="whatsapp_probnik_hero">WhatsApp</a>
          </div>
        </div>
        <img class="media-photo" src="/images/kabinet/zanyatie.jpg" width="1280" height="964" loading="eager" fetchpriority="high" alt="Ученики пишут пробный экзамен в кабинете «Эвриум» в Чехове" />
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Как это проходит</h2>
      <ol class="steps-list">
        <li>
          <h3>Записываетесь</h3>
          <p>Оставляете заявку или пишете в мессенджер. Согласуем день, время и объём работы: полный вариант или часть — зависит от того, сколько времени готов высидеть ребёнок.</p>
        </li>
        <li>
          <h3>Ребёнок пишет работу</h3>
          <p>В кабинете, по правилам экзамена: на время, без телефона и подсказок, с черновиком и бланком. Это важно — дома, с открытым интернетом, результат получается совсем другим.</p>
        </li>
        <li>
          <h3>Преподаватель проверяет вручную</h3>
          <p>Не автоматом по ключам, а с разбором хода решения: где ошибка в вычислениях, а где не понята сама тема. Вторая часть проверяется по критериям, как на настоящем экзамене.</p>
        </li>
        <li>
          <h3>Разбираем результат</h3>
          <p>Показываем балл и объясняем, из чего он сложился. Что решается уверенно, что на удачу, а что не решается вообще. Для 9 класса отдельно считаем геометрическую часть.</p>
        </li>
        <li>
          <h3>Даём рекомендации</h3>
          <p>Что подтянуть в первую очередь, в каком порядке и за какой срок это реально сделать. Рекомендации остаются у вас независимо от того, будете вы у нас заниматься или нет.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <h2>Зачем это нужно</h2>
      <div class="grid grid-2" style="margin-top: 22px;">
        <div class="card">
          <h3>Оценка в дневнике врёт</h3>
          <p>Школьная отметка складывается из работы за год: ответов у доски, домашних, контрольных по одной свежепройденной теме. На экзамене ребёнок один на один с задачей, которую надо разобрать самому. Разрыв между четвёркой в дневнике и баллом на ОГЭ бывает огромным — и обнаруживается он обычно слишком поздно.</p>
        </div>
        <div class="card">
          <h3>Страшно ровно один раз</h3>
          <p>Первый экзамен в жизни — это бланки, регламент, чужие люди и тишина в аудитории. Ребёнок, который уже проходил это в спокойной обстановке, на настоящем экзамене тратит силы на задачи, а не на панику.</p>
        </div>
        <div class="card">
          <h3>Видно, куда бить</h3>
          <p>«Подтянуть математику» — не план. «Не берёт четыре балла из семи на геометрии и теряет два на невнимательности в первой части» — план. Разница в том, что второе можно исправить за конкретный срок.</p>
        </div>
        <div class="card">
          <h3>Время ещё есть</h3>
          <p>Результат, полученный осенью, — это восемь месяцев на исправление. Тот же результат в мае — это уже данность, с которой придётся идти на экзамен.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="grid grid-2">
        <div class="card">
          <h3>Кому подойдёт</h3>
          <ul>
            <li><strong>9 класс</strong> — ОГЭ по математике, информатике, физике. Плюс отдельная оценка шансов на профильный класс.</li>
            <li><strong>11 класс</strong> — ЕГЭ, базовый и профильный уровень.</li>
            <li><strong>10 класс</strong> — если хотите заранее понять, с чего начинать год.</li>
            <li><strong>7–8 класс</strong> — тоже можно: возьмём диагностическую работу по программе, без экзаменационного формата.</li>
          </ul>
        </div>
        <div class="card">
          <h3>Что дальше</h3>
          <p>Если по итогам разбора мы понимаем, что можем помочь, — предлагаем план занятий. Если понимаем, что не можем или что вам достаточно позаниматься самостоятельно, — так и говорим.</p>
          <p>Никаких «осталось два места, решайте сегодня» не будет. Ребёнок и его баллы никуда не денутся за неделю раздумий.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <div class="container">
      <div class="card" style="max-width: 820px;">
        <h3>Девятиклассникам: зачем это именно сейчас</h3>
        <p>В 10 класс сегодня проходит меньше половины девятиклассников, а в профильные классы берут по конкурсу — смотрят баллы ОГЭ и годовые оценки. Пробник показывает, где ребёнок находится относительно этих требований, пока ещё можно что-то изменить.</p>
        <p><a href={`${site.basePath}/postuplenie-v-10-klass/`}>Как устроен отбор в 10 класс и сколько баллов нужно →</a></p>
      </div>
    </div>
  </section>

  <Faq items={faq} title="Частые вопросы о пробнике" />

  <LeadForm goal="kontrolnye" />

</Layout>

<style>
  .steps-list {
    max-width: 860px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps-list li {
    position: relative;
    padding: 0 0 22px 54px;
    counter-increment: step;
  }
  .steps-list li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--mar, #3A6098);
    color: #fff;
    font-family: 'Unbounded', sans-serif;
    font-weight: 700;
    font-size: 15px;
  }
  /* Линия, связывающая шаги в последовательность */
  .steps-list li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 17px;
    top: 40px;
    bottom: 4px;
    width: 2px;
    background: var(--c-border, #D9E0EC);
  }
  .steps-list h3 { margin: 4px 0 6px; font-size: 18px; }
  .steps-list p { margin: 0; }
</style>
