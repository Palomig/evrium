---
import { site, nav } from '../data/site.ts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">{site.centerName} · {site.centerTagline}</div>
        <p class="muted small">Очные занятия по математике, информатике и физике для школьников 2–11 классов. Подготовка к ОГЭ, ЕГЭ и олимпиадам.</p>
        <div class="btn-row" style="margin-top: 12px;">
          <a class="btn btn-wa" href={site.whatsapp} rel="nofollow noopener" target="_blank" data-cta="whatsapp_footer">WhatsApp</a>
          <a class="btn btn-tg" href={site.telegram} rel="nofollow noopener" target="_blank" data-cta="telegram_footer">Telegram</a>
        </div>
      </div>
      <div>
        <h4>Разделы сайта</h4>
        <ul class="footer-links">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Контакты</h4>
        <p>
          <a href={site.phoneHref} data-cta="phone_footer">{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <span class="muted small">{site.addressPublic}</span>
        </p>
        <p class="muted small">К нам приезжают ученики из: {site.studentAreas.join(', ')}. Занятия проходят только в нашем кабинете.</p>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="muted small">© {year} {site.centerName} · {site.centerTagline}. Все права защищены.</span>
      <span class="footer-bottom-links">
        <a href="/politika-konfidencialnosti/">Политика конфиденциальности</a>
        <a href="#" data-cookie-reopen>Управление куки</a>
      </span>
      <span class="muted small">Сайт не является публичной офертой.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(251,245,233,.82);
    border-top: 3px solid var(--ink);
    padding: 56px 0 24px;
    margin-top: 0;
  }
  .site-footer h4 { color: var(--accent-soft); font-family: 'Unbounded', sans-serif; font-size: 14px; text-transform: uppercase; letter-spacing: .05em; margin: 0 0 16px; }
  .site-footer a { color: rgba(244,246,251,.82); }
  .site-footer a:hover { color: var(--accent-soft); }
  .footer-brand { font-family: 'Unbounded', sans-serif; font-weight: 700; color: var(--paper); font-size: 18px; margin-bottom: 10px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: 40px; }
  .footer-links { list-style: none; padding: 0; margin: 0; columns: 2; }
  .footer-links li { margin: 0 0 8px; break-inside: avoid; }
  .footer-bottom { margin-top: 40px; padding-top: 20px; border-top: 1px solid rgba(244,246,251,.14); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; font-size: 13px; }
  .footer-bottom-links { display: flex; gap: 18px; flex-wrap: wrap; }
  .footer-bottom-links a { color: rgba(244,246,251,.6); }
  .footer-bottom-links a:hover { color: var(--accent-soft); }
  .small { font-size: 13px; }
  .muted { color: rgba(244,246,251,.6) !important; }
  @media (max-width: 800px) {
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .footer-links { columns: 1; }
  }
</style>
