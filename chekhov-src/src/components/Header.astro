---
import { nav, site } from '../data/site.ts';
const current = Astro.url.pathname.replace(/\/+$/, '/') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={`${site.basePath}/`}>
      <span class="brand-logo">Р<sup>+</sup></span>
      <span class="brand-text">
        <span class="brand-title">Репетитор в Чехове</span>
        <span class="brand-sub">математика · информатика · физика</span>
      </span>
    </a>
    <nav class="primary-nav" aria-label="Основная навигация">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class={current === item.href ? 'is-active' : ''}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-accent header-cta" href="#zayavka">Записаться</a>
    <button class="burger" aria-label="Открыть меню" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-nav" data-mobile-nav hidden>
    <ul>
      {nav.map((item) => (<li><a href={item.href}>{item.label}</a></li>))}
      <li><a class="btn btn-accent" style="width: 100%; justify-content: center;" href="#zayavka">Записаться на диагностику</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--c-border);
    box-shadow: 0 1px 4px rgba(20,30,50,.04);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: var(--header-h);
    padding: 10px 20px;
  }
  .brand {
    display: flex; align-items: center; gap: 12px;
    color: var(--c-primary);
    text-decoration: none;
    flex: 0 0 auto;
  }
  .brand:hover { text-decoration: none; }
  .brand-logo {
    width: 38px; height: 38px;
    background: var(--c-primary); color: #fff;
    display: grid; place-items: center;
    border-radius: 10px;
    font-weight: 800;
    font-size: 18px;
  }
  .brand-logo sup { font-size: 12px; color: var(--c-accent); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-title { font-weight: 700; font-size: 15px; }
  .brand-sub { font-size: 12px; color: var(--c-muted); }

  .primary-nav { flex: 1 1 auto; }
  .primary-nav ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 4px;
    justify-content: flex-end;
  }
  .primary-nav a {
    display: inline-block;
    padding: 8px 12px;
    color: var(--c-text);
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
  }
  .primary-nav a:hover { background: var(--c-bg-soft); text-decoration: none; }
  .primary-nav a.is-active { background: var(--c-bg-soft); color: var(--c-primary); }

  .header-cta { padding: 10px 16px; min-height: 40px; font-size: 14px; }

  .burger {
    display: none;
    background: transparent;
    border: 0;
    padding: 8px;
    width: 44px; height: 44px;
    cursor: pointer;
  }
  .burger span { display: block; width: 24px; height: 2px; background: var(--c-primary); margin: 5px auto; border-radius: 2px; }

  .mobile-nav {
    background: #fff;
    border-top: 1px solid var(--c-border);
    padding: 12px 20px 20px;
  }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
  .mobile-nav li { margin-bottom: 4px; }
  .mobile-nav a {
    display: block;
    padding: 12px 14px;
    color: var(--c-text);
    border-radius: 8px;
    font-weight: 500;
  }
  .mobile-nav a:hover { background: var(--c-bg-soft); text-decoration: none; }

  @media (max-width: 1024px) {
    .primary-nav, .header-cta { display: none; }
    .burger { display: block; margin-left: auto; }
  }
</style>

<script>
  const burger = document.querySelector('[data-burger]');
  const menu = document.querySelector('[data-mobile-nav]');
  burger?.addEventListener('click', () => {
    const open = menu.hasAttribute('hidden');
    if (open) menu.removeAttribute('hidden'); else menu.setAttribute('hidden', '');
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
