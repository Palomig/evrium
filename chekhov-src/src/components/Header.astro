---
import { nav, site, type NavItem } from '../data/site.ts';
const current = Astro.url.pathname.replace(/\/+$/, '/') || '/';

const isActive = (item: NavItem) => {
  if (item.href && current === item.href) return true;
  if (item.children?.some((c) => current === c.href)) return true;
  return false;
};
---
<div class="top-bar">
  <div class="container top-bar-inner">
    <a class="top-bar-item" href={site.mapUrl} target="_blank" rel="noopener nofollow">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path fill="currentColor" d="M12 2a8 8 0 0 0-8 8c0 5.4 7 11.6 7.3 11.8a1 1 0 0 0 1.4 0C13 21.6 20 15.4 20 10a8 8 0 0 0-8-8Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/>
      </svg>
      {site.addressPublic}
    </a>
    <a class="top-bar-item" href={site.phoneHref} data-cta="phone_topbar">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.3 1.1.4 2.3.6 3.5.6.6 0 1.1.5 1.1 1.1V20a1 1 0 0 1-1.1 1A18 18 0 0 1 3 4.1C3 3.5 3.5 3 4.1 3H7.4c.6 0 1.1.5 1.1 1.1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.3 1z"/>
      </svg>
      {site.phone}
    </a>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-logo">Э</span>
      <span class="brand-text">
        <span class="brand-title">{site.centerName}<span class="brand-tagline"> <span class="brand-em">·</span> {site.centerTagline}</span></span>
        <span class="brand-sub">математика · информатика · физика</span>
      </span>
    </a>
    <nav class="primary-nav" aria-label="Основная навигация">
      <ul>
        {nav.map((item) => (
          <li class:list={['nav-item', item.children && 'has-dropdown', isActive(item) && 'is-active']}>
            {item.children ? (
              <>
                <button type="button" class="nav-trigger" aria-haspopup="true" aria-expanded="false">
                  {item.label}
                  <svg class="caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                    <path fill="currentColor" d="M2 4l4 4 4-4z"/>
                  </svg>
                </button>
                <ul class="dropdown" role="menu">
                  {item.children.map((c) => (
                    <li role="none">
                      <a role="menuitem" href={c.href} class={current === c.href ? 'is-active' : ''}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-accent header-cta" href="#zayavka">Записаться</a>
    <button class="burger" aria-label="Открыть меню" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-nav" data-mobile-nav hidden>
    {nav.map((item) => (
      item.children ? (
        <div class="mobile-group">
          <div class="mobile-group-title">{item.label}</div>
          <ul>
            {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          </ul>
        </div>
      ) : (
        <ul class="mobile-flat"><li><a href={item.href}>{item.label}</a></li></ul>
      )
    ))}
    <div class="mobile-cta">
      <a class="btn btn-accent" style="width: 100%; justify-content: center;" href="#zayavka">Записаться на диагностику</a>
    </div>
  </div>
</header>

<style>
  /* Top bar — тёмная ink-полоса */
  .top-bar {
    background: var(--ink);
    color: var(--paper);
    font-size: 13px;
  }
  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 22px;
    min-height: 34px;
    padding: 7px 22px;
  }
  .top-bar-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--paper);
    text-decoration: none;
    font-weight: 500;
  }
  .top-bar-item:hover { color: var(--mar); text-decoration: none; }
  .top-bar-item svg { flex-shrink: 0; color: var(--mar); }
  @media (max-width: 640px) {
    .top-bar-inner { font-size: 12px; gap: 14px; padding: 7px 16px; justify-content: center; flex-wrap: wrap; }
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 3px solid var(--ink);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: var(--header-h);
    padding: 12px 22px;
  }
  .brand {
    display: flex; align-items: center; gap: 12px;
    color: var(--ink);
    text-decoration: none;
    flex: 0 1 auto;
    min-width: 0;
  }
  .brand:hover { text-decoration: none; }
  .brand-text { min-width: 0; }
  .brand-title { white-space: nowrap; }
  .brand-logo {
    width: 42px; height: 42px;
    background: var(--mar); color: var(--ink);
    display: grid; place-items: center;
    border-radius: 12px;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: 'Unbounded', sans-serif;
    font-weight: 800;
    font-size: 19px;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.12; }
  .brand-title { font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 15px; color: var(--ink); }
  .brand-em { color: var(--mar-2); margin: 0 4px; }
  .brand-sub { font-size: 12px; color: var(--ink-2); }

  /* Primary nav */
  .primary-nav { flex: 1 1 auto; }
  .primary-nav > ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: 2px;
    justify-content: flex-end;
    align-items: center;
  }
  .nav-item { position: relative; }
  .nav-item > a,
  .nav-item > .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 10px 13px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    background: transparent;
    border: 2px solid transparent;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.2;
    white-space: nowrap;
  }
  .nav-item > a:hover,
  .nav-item > .nav-trigger:hover { background: #fff; border-color: var(--ink); text-decoration: none; }
  .nav-item.is-active > a,
  .nav-item.is-active > .nav-trigger { background: var(--mar); border-color: var(--ink); color: var(--ink); }
  .nav-trigger .caret { flex: 0 0 auto; width: 10px; height: 10px; opacity: .7; transition: transform .15s ease; }
  .has-dropdown.is-open .nav-trigger .caret,
  .has-dropdown:hover .nav-trigger .caret { transform: rotate(180deg); }

  /* Dropdown */
  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 210px;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 14px;
    box-shadow: 6px 6px 0 var(--ink);
    list-style: none;
    margin: 0;
    padding: 8px;
    z-index: 51;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity .15s ease, transform .15s ease;
  }
  /* Невидимый «мостик» над выпадашкой, чтобы курсор не терял ховер в зазоре */
  .dropdown::before {
    content: '';
    position: absolute;
    left: 0; right: 0;
    top: -12px;
    height: 12px;
  }
  .has-dropdown:hover > .dropdown,
  .has-dropdown:focus-within > .dropdown,
  .has-dropdown.is-open > .dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .dropdown a {
    display: block;
    padding: 10px 12px;
    color: var(--ink);
    border-radius: 9px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .dropdown a:hover { background: var(--paper-2); text-decoration: none; }
  .dropdown a.is-active { background: var(--mar); color: var(--ink); font-weight: 700; }

  .header-cta { padding: 11px 18px; min-height: 44px; font-size: 14px; border-radius: 12px; }

  /* Burger */
  .burger {
    display: none;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--ink);
    padding: 8px;
    width: 46px; height: 46px;
    cursor: pointer;
  }
  .burger span { display: block; width: 22px; height: 2.5px; background: var(--ink); margin: 4px auto; border-radius: 2px; }

  /* Mobile menu */
  .mobile-nav {
    background: var(--paper);
    border-top: 2px solid var(--ink);
    padding: 16px 22px 22px;
  }
  .mobile-group { margin-bottom: 14px; }
  .mobile-group-title {
    font-family: 'Unbounded', sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--ink-2);
    font-weight: 700;
    padding: 0 12px;
    margin-bottom: 6px;
  }
  .mobile-nav ul { list-style: none; margin: 0 0 6px; padding: 0; }
  .mobile-nav li { margin: 0; }
  .mobile-nav a {
    display: block;
    padding: 12px 14px;
    color: var(--ink);
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
  }
  .mobile-nav a:hover { background: #fff; text-decoration: none; }
  .mobile-cta { margin-top: 14px; }

  @media (max-width: 1024px) {
    .primary-nav, .header-cta { display: none; }
    .burger { display: block; margin-left: auto; }
  }
  /* На телефонах оставляем логотип + «Эвриум», длинный тег-лайн прячем,
     чтобы шапка не растягивала страницу по ширине */
  @media (max-width: 560px) {
    .brand-tagline, .brand-sub { display: none; }
    .header-inner { gap: 12px; padding: 12px 16px; }
    .top-bar-inner { padding-left: 16px; padding-right: 16px; }
  }
</style>

<script>
  // Burger toggle
  const burger = document.querySelector('[data-burger]');
  const menu = document.querySelector('[data-mobile-nav]');
  burger?.addEventListener('click', () => {
    const open = menu.hasAttribute('hidden');
    if (open) menu.removeAttribute('hidden'); else menu.setAttribute('hidden', '');
    burger.setAttribute('aria-expanded', String(open));
  });

  // Click-to-toggle for touch users (also handles keyboard via Enter/Space on button)
  document.querySelectorAll('.has-dropdown .nav-trigger').forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const parent = trigger.closest('.has-dropdown');
      if (!parent) return;
      const wasOpen = parent.classList.contains('is-open');
      // Закрываем все остальные
      document.querySelectorAll('.has-dropdown.is-open').forEach((el) => el.classList.remove('is-open'));
      if (!wasOpen) {
        parent.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      } else {
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Close dropdowns on outside click
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    if (e.target.closest('.has-dropdown')) return;
    document.querySelectorAll('.has-dropdown.is-open').forEach((el) => {
      el.classList.remove('is-open');
      el.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('.has-dropdown.is-open').forEach((el) => {
      el.classList.remove('is-open');
      el.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
