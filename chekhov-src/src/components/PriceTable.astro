---
import { site } from '../data/site.ts';
// Цену делим на сумму и единицу («1 500 ₽ / занятие»): на мобильном
// единица уходит отдельной строкой под суммой, на десктопе остаётся в строку.
const rows = Object.values(site.prices).map((r) => {
  const [amount, unit] = r.price.split(' / ');
  return { ...r, amount, unit };
});
---
<div class="price-table-wrap">
<table class="price-table">
  <thead>
    <tr>
      <th>Формат</th>
      <th>Длительность</th>
      <th>Цена</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <td>{r.label}</td>
        <td class="muted">{r.duration}</td>
        <td class="price">{r.amount}{r.unit && <span class="price-unit"> / {r.unit}</span>}</td>
      </tr>
    ))}
  </tbody>
</table>
</div>
<p class="muted small" style="margin-top: 12px;">
  Групповые занятия — фиксированная оплата за месяц. Первая диагностика — бесплатно.
</p>
